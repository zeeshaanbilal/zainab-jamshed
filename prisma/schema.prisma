generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Blog {
  id        String   @id @default(cuid())
  title     String
  author    String
  date      String
  excerpt   String
  content   String
  image     String
  delay     String   @default("0.2s")
  createdAt DateTime @default(now())
}
