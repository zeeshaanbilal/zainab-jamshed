generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Blog {
  id        String   @id @default(cuid())
  slug      String   @unique @default(cuid())
  title     String
  author    String
  date      String
  excerpt   String
  content   String
  image     String
  delay     String   @default("0.2s")
  titlePt   String?
  excerptPt String?
  contentPt String?
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}
